# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Required ---
# Password of the database user
DB_PASSWORD=
# JWT signing secret, at least 32 bytes (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# --- Optional (defaults shown) ---
DB_URL=jdbc:postgresql://localhost:5432/budget-planner
DB_USERNAME=postgres
# Comma-separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200

# --- Local development only ---
# SPRING_PROFILES_ACTIVE=dev
# Password for the seeded dev user `hendrik` (dev profile, empty users table)
# DEV_SEED_PASSWORD=
